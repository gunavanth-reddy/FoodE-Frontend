PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/foode
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# FoodE email configuration (Gmail SMTP example)
# FOODE_EMAIL must be the Gmail account that generated the App Password.
# Never use your regular Gmail password. Keep the real .env private.
FOODE_EMAIL=your-sender@gmail.com
FOODE_EMAIL_APP_PASSWORD=your-16-character-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Optional: send test messages to a separate inbox. Defaults to FOODE_EMAIL.
# SMTP_TEST_TO=your-test-inbox@example.com
# Optional display sender. Defaults to FoodE <FOODE_EMAIL>.
# FOODE_FROM_EMAIL=FoodE <your-sender@gmail.com>

# Optional auth rate limits. These are app-level limits, not email-provider quotas.
OTP_SEND_RATE_LIMIT_MAX=1000
OTP_VERIFY_RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=1000

# Cloudinary (required for restaurant/food image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Firebase Admin / FCM
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
